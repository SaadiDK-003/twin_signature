{% assign starter_image = '' %}{% if section.settings.use_starter_image %}{% assign starter_image = 'ref-1443.jpg' %}{% endif %}
{% capture image %}{% render 'ts-media', image: section.settings.image, fallback: starter_image, alt: section.settings.heading, width: 1000, height: 800, sizes: '(min-width: 750px) 50vw, 100vw' %}{% endcapture %}{% assign image = image | strip %}
{% capture content %}
  {% if section.settings.eyebrow != blank %}<p class="promotion__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
  {% if section.settings.heading != blank %}<h2>{{ section.settings.heading | escape | newline_to_br }}</h2>{% endif %}
  {% if section.settings.end_date != blank %}<div class="countdown" data-countdown="{{ section.settings.end_date | escape }}" aria-label="Time remaining in the promotion"></div>{% endif %}
  {% if section.settings.text != blank %}<p class="promotion__text">{{ section.settings.text | escape }}</p>{% endif %}
  {% if section.settings.label != blank %}<a href="{{ section.settings.link | default: routes.all_products_collection_url }}" class="button">{{ section.settings.label | escape }}</a>{% endif %}
{% endcapture %}{% assign content = content | strip %}
{% if image != blank or content != blank %}<div class="promotion full-width"><div class="container promotion__grid">{% if image != blank %}<div class="promotion__image">{{ image }}</div>{% endif %}{% if content != blank %}<div class="promotion__content">{{ content }}</div>{% endif %}</div></div>{% endif %}
{% schema %}
{
  "name": "Featured promotion",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Featured Product Of This Week"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Only High Quality Is The\nCore Value For Us."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "Discover a considered collection of memorable fragrances. Beautifully crafted scents, selected to become a part of your everyday story."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "end_date",
      "label": "Countdown end (ISO date with timezone)"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Button text",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "use_starter_image",
      "label": "Use included starter image when no image is selected",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Featured promotion"
    }
  ]
}
{% endschema %}
