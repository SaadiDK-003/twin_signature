{% assign group = section.settings.collection %}{% if group == blank %}{% assign group = collections[section.settings.handle] %}{% endif %}
<div class="container section-space popular-section" data-carousel><div class="section-heading"><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.subtitle | escape }}</p></div><div class="carousel-wrap"><div class="product-carousel" data-carousel-track>{% assign selected_products = section.settings.products | default: group.products %}{% for item in selected_products limit: section.settings.limit %}{% render 'ts-product-card', product: item %}{% endfor %}</div><button class="carousel-arrow previous" data-carousel-step="-1" aria-label="Previous products">{% render 'ts-icon', name: 'chevron' %}</button><button class="carousel-arrow next" data-carousel-step="1" aria-label="Next products">{% render 'ts-icon', name: 'chevron' %}</button></div>{% if group != blank %}<div class="center"><a class="button" href="{{ group.url }}">View all</a></div>{% endif %}</div>
{% schema %}
{
  "name": "Perfume carousel",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Popular Perfumes"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Each fragrance crafted to complement your unique essence"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "handle",
      "label": "Default collection handle",
      "default": "popular-perfumes"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Products",
      "min": 4,
      "max": 16,
      "step": 1,
      "default": 8
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Featured products (optional)",
      "limit": 16
    }
  ],
  "presets": [
    {
      "name": "Perfume carousel"
    }
  ]
}
{% endschema %}
