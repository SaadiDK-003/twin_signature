{% assign group = section.settings.collection %}
{% assign selected_products = section.settings.products | default: group.products %}
{% if selected_products != blank %}
<div class="container section-space popular-section" data-carousel>
  {% render 'ts-section-heading', heading: section.settings.heading, subtitle: section.settings.subtitle %}
  <div class="carousel-wrap"><div class="product-carousel" data-carousel-track>{% for item in selected_products limit: section.settings.limit %}{% render 'ts-product-card', product: item %}{% endfor %}</div>{% if selected_products.size > 1 %}<button class="carousel-arrow previous" data-carousel-step="-1" aria-label="Previous products">{% render 'ts-icon', name: 'chevron' %}</button><button class="carousel-arrow next" data-carousel-step="1" aria-label="Next products">{% render 'ts-icon', name: 'chevron' %}</button>{% endif %}</div>
  {% if group != blank and section.settings.view_all_label != blank %}<div class="center"><a class="button" href="{{ group.url }}">{{ section.settings.view_all_label | escape }}</a></div>{% endif %}
</div>
{% elsif request.design_mode %}<div class="container editor-placeholder">Choose products or a collection for this carousel.</div>{% endif %}
{% schema %}
{
  "name": "Perfume carousel",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Popular Perfumes"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Each fragrance crafted to complement your unique essence"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Products",
      "min": 4,
      "max": 16,
      "step": 1,
      "default": 8
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Featured products (optional)",
      "limit": 16
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all button text",
      "default": "View all"
    }
  ],
  "presets": [
    {
      "name": "Perfume carousel"
    }
  ]
}
{% endschema %}
