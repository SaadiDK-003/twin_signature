<div class="container section-space collection-banners">{% for block in section.blocks %}{% assign group = block.settings.collection %}<a class="collection-banner" href="{{ group.url | default: block.settings.link | default: routes.collections_url }}" {{ block.shopify_attributes }}>{% render 'ts-media', image: block.settings.image, fallback: block.settings.fallback, width: 1000, height: 1000, alt: block.settings.title, sizes: '(min-width: 990px) 50vw, 100vw' %}<div><h2>{{ block.settings.title | escape }}</h2>{% if group != blank %}<span>({{ group.products_count }} Items)</span>{% endif %}</div></a>{% endfor %}</div>
{% schema %}
{
  "name": "Collection banners",
  "settings": [],
  "presets": [
    {
      "name": "Collection banners"
    }
  ],
  "max_blocks": 3,
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Women Perfumes"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Fallback link"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "fallback",
          "label": "Default asset",
          "default": "ref-259.jpg"
        }
      ]
    }
  ]
}
{% endschema %}
