<div class="container section-space best-sellers-section" data-tabs><h2 class="section-title">{{ section.settings.heading | escape }}</h2><div class="product-tabs" role="tablist" aria-label="{{ section.settings.heading | escape }}">{% for block in section.blocks %}<button role="tab" id="Tab-{{ section.id }}-{{ forloop.index }}" aria-controls="Panel-{{ section.id }}-{{ forloop.index }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" tabindex="{% if forloop.first %}0{% else %}-1{% endif %}">{{ block.settings.label | escape }}</button>{% endfor %}</div>
{% for block in section.blocks %}{% assign group = block.settings.collection %}{% if group == blank %}{% assign group = collections[block.settings.handle] %}{% endif %}<div class="product-grid" role="tabpanel" id="Panel-{{ section.id }}-{{ forloop.index }}" aria-labelledby="Tab-{{ section.id }}-{{ forloop.index }}" {% unless forloop.first %}hidden{% endunless %} {{ block.shopify_attributes }}>{% assign selected_products = block.settings.products | default: group.products %}{% for item in selected_products limit: section.settings.limit %}{% render 'ts-product-card', product: item %}{% else %}<p class="empty-collection">Choose a collection in the theme editor to display your perfumes here.</p>{% endfor %}</div>{% endfor %}</div>
{% schema %}
{
  "name": "Best seller tabs",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Best Sellers"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Maximum products",
      "min": 4,
      "max": 16,
      "step": 4,
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Best seller tabs"
    }
  ],
  "max_blocks": 5,
  "blocks": [
    {
      "type": "tab",
      "name": "Collection tab",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Tab label",
          "default": "Women"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "handle",
          "label": "Default collection handle",
          "default": "best-sellers"
        },
        {
          "type": "product_list",
          "id": "products",
          "label": "Featured products (optional)",
          "limit": 16
        }
      ]
    }
  ]
}
{% endschema %}
