{% assign tab_count = 0 %}
{% capture tabs %}{% for block in section.blocks %}
  {% assign group = block.settings.collection %}{% assign selected_products = block.settings.products | default: group.products %}
  {% if selected_products != blank and block.settings.label != blank %}
    <button type="button" role="tab" id="Tab-{{ section.id }}-{{ block.id }}" aria-controls="Panel-{{ section.id }}-{{ block.id }}" aria-selected="{% if tab_count == 0 %}true{% else %}false{% endif %}" tabindex="{% if tab_count == 0 %}0{% else %}-1{% endif %}">{{ block.settings.label | escape }}</button>
    {% assign tab_count = tab_count | plus: 1 %}
  {% endif %}
{% endfor %}{% endcapture %}
{% if tab_count > 0 %}
<div class="container section-space best-sellers-section" data-tabs>
  {% if section.settings.heading != blank %}<h2 class="section-title">{{ section.settings.heading | escape }}</h2>{% endif %}
  {% if tab_count > 1 %}<div class="product-tabs" role="tablist" aria-label="{{ section.settings.heading | default: 'Featured collections' | escape }}">{{ tabs }}</div>{% endif %}
  {% assign panel_index = 0 %}
  {% for block in section.blocks %}{% assign group = block.settings.collection %}{% assign selected_products = block.settings.products | default: group.products %}
    {% if selected_products != blank and block.settings.label != blank %}<div class="product-grid" {% if tab_count > 1 %}role="tabpanel" aria-labelledby="Tab-{{ section.id }}-{{ block.id }}"{% else %}role="group" aria-label="{{ block.settings.label | escape }}"{% endif %} id="Panel-{{ section.id }}-{{ block.id }}" {% unless panel_index == 0 %}hidden{% endunless %} {{ block.shopify_attributes }}>{% for item in selected_products limit: section.settings.limit %}{% render 'ts-product-card', product: item %}{% endfor %}</div>{% assign panel_index = panel_index | plus: 1 %}{% endif %}
  {% endfor %}
</div>
{% elsif request.design_mode %}<div class="container editor-placeholder">Add a tab with a label and products or a collection.</div>{% endif %}
{% schema %}
{
  "name": "Best seller tabs",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Best Sellers"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Maximum products",
      "min": 4,
      "max": 16,
      "step": 4,
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Best seller tabs"
    }
  ],
  "max_blocks": 5,
  "blocks": [
    {
      "type": "tab",
      "name": "Collection tab",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Tab label",
          "default": "Women"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "product_list",
          "id": "products",
          "label": "Featured products (optional)",
          "limit": 16
        }
      ]
    }
  ]
}
{% endschema %}
