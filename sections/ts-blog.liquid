{% assign journal = section.settings.blog | default: blogs.news %}<div class="container section-space journal-section"><div class="journal-heading"><div><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2></div><a class="text-link" href="{{ journal.url | default: '/blogs/news' }}">View All</a></div><div class="blog-grid">{% for entry in journal.articles limit: 3 %}<article class="blog-card"><a href="{{ entry.url }}">{% render 'ts-media', image: entry.image, alt: entry.title, width: 800, height: 550, sizes: '(min-width: 750px) 33vw, 100vw' %}</a><p class="blog-meta"><span>{% render 'ts-icon', name: 'user' %}{{ entry.author | escape }}</span><span>{% render 'ts-icon', name: 'calendar' %}<time datetime="{{ entry.published_at | date: '%Y-%m-%d' }}">{{ entry.published_at | date: '%b %d, %Y' }}</time></span></p><h3><a href="{{ entry.url }}">{{ entry.title | escape }}</a></h3></article>{% endfor %}</div></div>
{% schema %}
{
  "name": "Fragrance journal",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "OUR BLOG"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "News & Blog Updates"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    }
  ],
  "presets": [
    {
      "name": "Fragrance journal"
    }
  ]
}
{% endschema %}
