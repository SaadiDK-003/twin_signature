<div class="container section-space"><div class="faq-layout"><div><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% if request.page_type == 'page' and page.handle == 'faq' %}<h1>{{ section.settings.heading | escape }}</h1>{% else %}<h2>{{ section.settings.heading | escape }}</h2>{% endif %}{% for block in section.blocks %}<details class="faq-item" {% if forloop.first %}open{% endif %} {{ block.shopify_attributes }}><summary>{{ block.settings.question | escape }}</summary><p>{{ block.settings.answer | escape }}</p></details>{% endfor %}</div><aside class="help-card"><h3>Still Have Questions?</h3><p>Our team is here to help you find your signature.</p><a class="button" href="{{ routes.root_url }}pages/contact-us">Here to help</a></aside></div></div>
{% schema %}
{
  "name": "Fragrance FAQ",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "FREQUENTLY ASKED QUESTIONS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Some Frequently Asked Questions."
    }
  ],
  "presets": [
    {
      "name": "Fragrance FAQ"
    }
  ],
  "max_blocks": 12,
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer"
        }
      ]
    }
  ]
}
{% endschema %}
