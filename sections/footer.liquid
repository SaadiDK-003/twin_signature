<footer class="site-footer full-width">
  <div class="container footer-grid">
    <div class="footer-brand">
      {% if section.settings.logo != blank %}
        <a class="footer-logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }} home">{{ section.settings.logo | image_url: width: 480 | image_tag: widths: '240, 480', sizes: '220px', alt: shop.name, loading: 'lazy' }}</a>
      {% elsif settings.client_branding %}
        <a class="footer-logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }} home"><img src="{{ 'twin-signature-client-original.jpg' | asset_img_url: '440x' }}" srcset="{{ 'twin-signature-client-original.jpg' | asset_img_url: '220x' }} 220w, {{ 'twin-signature-client-original.jpg' | asset_img_url: '440x' }} 440w" sizes="220px" width="640" height="640" alt="Twin Signature AM — Beyond Fragrance" loading="lazy"></a>
      {% else %}
        <a class="wordmark" href="{{ routes.root_url }}">{% render 'ts-icon', name: 'bottle' %}<span>TWIN SIGNATURE<small>PERFUME SHOP</small></span></a>
      {% endif %}
      <p>{{ section.settings.description | escape }}</p>
      {% assign share_url = shop.url | url_encode %}
      <div class="social-links" aria-label="Share Twin Signature">
        <a href="https://twitter.com/intent/tweet?url={{ share_url }}" target="_blank" rel="noopener" aria-label="Share on X">{% render 'ts-icon', name: 'x-social' %}</a>
        {% if section.settings.instagram != blank %}<a href="{{ section.settings.instagram }}" target="_blank" rel="noopener" aria-label="Instagram">{% render 'ts-icon', name: 'instagram' %}</a>{% else %}<button type="button" data-copy-store-link="{{ shop.url | escape }}" aria-label="Copy store link">{% render 'ts-icon', name: 'link' %}</button>{% endif %}
        <a href="{% if section.settings.facebook != blank %}{{ section.settings.facebook }}{% else %}https://www.facebook.com/sharer/sharer.php?u={{ share_url }}{% endif %}" target="_blank" rel="noopener" aria-label="Facebook">{% render 'ts-icon', name: 'facebook' %}</a>
        <a href="https://pinterest.com/pin/create/button/?url={{ share_url }}" target="_blank" rel="noopener" aria-label="Share on Pinterest">{% render 'ts-icon', name: 'pinterest' %}</a>
        <a href="mailto:?subject=Twin%20Signature&amp;body={{ share_url }}" aria-label="Share by email">{% render 'ts-icon', name: 'mail' %}</a>
      </div>
    </div>
    <div><h2>Useful Links</h2><ul><li><a href="{{ routes.account_url }}">My Account</a></li><li><a href="{{ routes.cart_url }}">Shopping Cart</a></li><li><a href="{{ routes.root_url }}pages/wishlist">My Wishlist</a></li><li><a href="{{ routes.root_url }}pages/about-us">Our Store Info</a></li></ul></div>
    <div><h2>Information</h2><ul>{% if section.settings.information_menu != blank %}{% for link in section.settings.information_menu.links %}<li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>{% endfor %}{% else %}<li><a href="{{ routes.account_url }}">Order Tracking</a></li><li><a href="{{ routes.root_url }}pages/shipping-returns">Shipping & Returns</a></li><li><a href="{{ routes.root_url }}pages/privacy-policy">Privacy Policy</a></li><li><a href="{{ routes.root_url }}pages/terms-conditions">Terms of Service</a></li>{% endif %}</ul></div>
    <div class="footer-newsletter"><h2>Newsletter</h2><p>{{ section.settings.newsletter_text | escape }}</p>{% form 'customer', id: 'FooterNewsletter', class: 'newsletter-form' %}<input type="hidden" name="contact[tags]" value="newsletter"><div class="email-input"><label class="visually-hidden" for="FooterEmail">Email address</label><input id="FooterEmail" type="email" name="contact[email]" placeholder="Enter your email" required autocomplete="email"><button type="submit" aria-label="Subscribe">{% render 'ts-icon', name: 'arrow' %}</button></div>{% if form.posted_successfully? %}<p role="status">Thank you for subscribing.</p>{% endif %}{{ form.errors | default_errors }}{% endform %}</div>
  </div>
  <div class="footer-bottom-wrap"><div class="container footer-bottom">
    {% if section.settings.show_payment_icons %}<div class="payment-icons" aria-label="{% if shop.enabled_payment_types == empty %}Sample payment icons{% else %}Payment methods{% endif %}">{% assign payment_types = shop.enabled_payment_types %}{% if payment_types == empty and section.settings.show_sample_payment_icons %}{% assign payment_types = 'visa,master,american_express,paypal,diners_club,discover' | split: ',' %}{% endif %}{% for type in payment_types %}{{ type | payment_type_svg_tag }}{% endfor %}</div>{% endif %}
    <p>© {{ 'now' | date: '%Y' }}, Twin Signature. All rights reserved.</p>
    <div class="footer-locale">
      {% form 'localization', id: 'FooterLocalization' %}
        <label class="visually-hidden" for="FooterCountry">Country and currency</label><select id="FooterCountry" name="country_code" data-localization-select>{% for country in localization.available_countries %}<option value="{{ country.iso_code }}" {% if country.iso_code == localization.country.iso_code %}selected{% endif %}>{{ country.currency.iso_code }} {{ country.currency.symbol }}</option>{% endfor %}</select>
        <label class="visually-hidden" for="FooterLanguage">Language</label><select id="FooterLanguage" name="locale_code" data-localization-select>{% for language in localization.available_languages %}<option value="{{ language.iso_code }}" {% if language.iso_code == localization.language.iso_code %}selected{% endif %}>{{ language.endonym_name | upcase }}</option>{% endfor %}</select><noscript><button type="submit">Update</button></noscript>
      {% endform %}
    </div>
  </div></div>
</footer>
{% schema %}{
  "name": "Footer",
  "settings": [
    {"type": "image_picker", "id": "logo", "label": "Footer logo"},
    {
      "type": "link_list",
      "id": "information_menu",
      "label": "Information menu"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Brand description",
      "default": "Twin Signature was founded on the belief that perfume is more than a finishing touch\u2014it's a personal expression of who you are."
    },
    {
      "type": "textarea",
      "id": "newsletter_text",
      "label": "Newsletter text",
      "default": "Subscribe to our newsletter for new arrivals, fragrance stories, and special offers."
    },
    {
      "type": "url",
      "id": "instagram",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "facebook",
      "label": "Facebook URL"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_sample_payment_icons",
      "label": "Show sample payment icons until payment methods are configured",
      "default": true
    }
  ]
}{% endschema %}
