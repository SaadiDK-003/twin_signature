{% capture heading %}{% render 'ts-section-heading', heading: section.settings.heading, eyebrow: section.settings.eyebrow, class: 'video-feature__content', eyebrow_class: 'video-feature__eyebrow' %}{% endcapture %}{% assign heading = heading | strip %}
{% capture poster %}{% render 'ts-media', image: section.settings.image, fallback: section.settings.fallback, width: 1600, height: 550, alt: section.settings.heading, sizes: '(min-width: 990px) 76vw, 100vw' %}{% endcapture %}{% assign poster = poster | strip %}
{% if heading != blank or poster != blank or section.settings.video_url != blank %}
<div class="video-feature full-width"><div class="container">{{ heading }}{% if poster != blank or section.settings.video_url != blank %}<div class="video-feature__poster">{% if poster != blank %}<div class="video-feature__image">{{ poster }}</div>{% endif %}{% if section.settings.video_url != blank %}<button type="button" class="play-button" data-video-url="{{ section.settings.video_url | escape }}" aria-label="Play fragrance film" aria-expanded="false" aria-controls="VideoPlayer-{{ section.id }}" data-video-player-id="VideoPlayer-{{ section.id }}">{% render 'ts-icon', name: 'play' %}</button>{% endif %}</div>{% endif %}</div></div>{% endif %}
{% schema %}
{
  "name": "Signature video",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Your Signature Scent"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Find The Perfect Perfume To\nExpress Your Unique Style."
    },
    {
      "type": "header",
      "content": "Video"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "YouTube or Vimeo embed URL",
      "default": "https://www.youtube-nocookie.com/embed/_9VUPq3SxOc"
    },
    {
      "type": "header",
      "content": "Poster image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Poster"
    },
    {
      "type": "text",
      "id": "fallback",
      "label": "Default poster asset",
      "default": "ref-Untitled-1.png"
    }
  ],
  "presets": [
    {
      "name": "Signature video"
    }
  ]
}
{% endschema %}
