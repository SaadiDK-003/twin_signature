{% render 'ts-breadcrumbs', title: 'Search' %}<div class="container section-space"><h1 class="page-heading">Find Your Next Favourite</h1><form class="search-form" action="{{ routes.search_url }}" method="get" role="search"><label class="visually-hidden" for="PageSearch">Search</label><input type="search" id="PageSearch" name="q" value="{{ search.terms | escape }}" placeholder="Search our store"><button aria-label="Search">{% render 'ts-icon', name: 'search' %}</button></form>{% if search.performed %}<p class="search-count">{{ search.results_count }} results for “{{ search.terms | escape }}”</p>{% paginate search.results by 12 %}<div class="product-grid">{% for item in search.results %}{% if item.object_type == 'product' %}{% render 'ts-product-card', product: item %}{% else %}<article class="blog-card">{% if item.image %}{% render 'ts-media', image: item.image, alt: item.title, width: 600, height: 400 %}{% endif %}<h2><a href="{{ item.url }}">{{ item.title | escape }}</a></h2><p>{{ item.content | strip_html | truncatewords: 20 }}</p></article>{% endif %}{% else %}<div class="empty-state"><h2>No results found</h2><p>Try a perfume name or a different search term.</p></div>{% endfor %}</div>{% if paginate.pages > 1 %}<div class="pagination">{{ paginate | default_pagination }}</div>{% endif %}{% endpaginate %}{% endif %}</div>
{% schema %}
{
  "name": "Search results",
  "settings": [],
  "presets": [
    {
      "name": "Search results"
    }
  ]
}
{% endschema %}
