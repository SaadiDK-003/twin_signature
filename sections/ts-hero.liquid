<div class="hero full-width" data-slideshow data-autoplay="{{ section.settings.autoplay }}" aria-roledescription="carousel" aria-label="Featured fragrances">
 <div class="hero__slides">{% for block in section.blocks %}{% assign eager = 'lazy' %}{% if forloop.first %}{% assign eager = 'eager' %}{% endif %}
  <div class="hero__slide{% if forloop.first %} is-active{% endif %}" data-slide role="group" aria-label="Slide {{ forloop.index }} of {{ section.blocks.size }}" {% unless forloop.first %}inert{% endunless %} {{ block.shopify_attributes }}>
   <div class="hero__desktop">{% render 'ts-media', image: block.settings.image, fallback: block.settings.fallback, loading: eager, width: 1920, height: 750, alt: block.settings.heading, sizes: '100vw' %}</div>
   <div class="hero__mobile">{% render 'ts-media', image: block.settings.mobile_image, fallback: block.settings.mobile_fallback, loading: eager, width: 750, height: 1050, alt: block.settings.heading, sizes: '100vw' %}</div>
   <div class="container hero__content"><p class="eyebrow">{{ block.settings.eyebrow | escape }}</p>{% if forloop.first %}<h1 class="hero-title">{{ block.settings.heading | escape | newline_to_br }}</h1>{% else %}<h2 class="hero-title">{{ block.settings.heading | escape | newline_to_br }}</h2>{% endif %}<a class="button" href="{{ block.settings.link | default: routes.all_products_collection_url }}">{{ block.settings.label | escape }}</a></div>
  </div>{% endfor %}</div>
 <button class="hero-arrow hero-arrow--previous" data-slide-step="-1" aria-label="Previous slide">{% render 'ts-icon', name: 'chevron' %}</button><button class="hero-arrow hero-arrow--next" data-slide-step="1" aria-label="Next slide">{% render 'ts-icon', name: 'chevron' %}</button>
 <div class="hero-dots">{% for block in section.blocks %}<button data-slide-to="{{ forloop.index0 }}" aria-label="Go to slide {{ forloop.index }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"></button>{% endfor %}<button class="slideshow-pause" data-slideshow-pause aria-label="Pause slideshow">Ⅱ</button></div>
</div>
{% schema %}
{
  "name": "Signature slideshow",
  "settings": [
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Automatically rotate slides",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Signature slideshow"
    }
  ],
  "max_blocks": 6,
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow",
          "default": "FRAGRANCES DEFINE YOU"
        },
        {
          "type": "textarea",
          "id": "heading",
          "label": "Heading",
          "default": "Explore Your\nSignature Scent"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Desktop image"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile image"
        },
        {
          "type": "text",
          "id": "fallback",
          "label": "Default desktop asset",
          "default": "ref-s4.jpg"
        },
        {
          "type": "text",
          "id": "mobile_fallback",
          "label": "Default mobile asset",
          "default": "ref-smx1.jpg"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Button text",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Button link"
        }
      ]
    }
  ]
}
{% endschema %}
