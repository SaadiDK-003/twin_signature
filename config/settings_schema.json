[
  {
    "name": "theme_info",
    "theme_name": "Twin Signature",
    "theme_version": "0.1.0",
    "theme_author": "Shopify",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "inter_n4",
        "label": "t:general.primary"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "default": "#FFFFFF",
        "label": "t:labels.background"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#333333",
        "label": "t:labels.foreground"
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 4
      }
    ]
  },
  {
    "name": "Twin Signature",
    "settings": [
      {
        "type": "checkbox",
        "id": "client_branding",
        "label": "Use client gold logo and black footer",
        "default": false,
        "info": "Applies the compact client wordmark, original footer artwork, and black-and-gold accents. Custom header and footer logos take priority."
      },
      {
        "type": "color",
        "id": "accent_color",
        "label": "Accent color",
        "default": "#5d3754"
      },
      {
        "type": "checkbox",
        "id": "newsletter_popup",
        "label": "Show newsletter signup popup",
        "default": true
      },
      {
        "type": "text",
        "id": "popup_heading",
        "label": "Newsletter popup heading",
        "default": "Discover your next signature."
      },
      {
        "type": "textarea",
        "id": "popup_text",
        "label": "Newsletter popup text",
        "default": "Sign up for our newsletter to be the first to learn about new arrivals, special promotions, and online exclusives."
      },
      {
        "type": "text",
        "id": "popup_button_label",
        "label": "Newsletter popup button text",
        "default": "Subscribe"
      },
      {
        "type": "textarea",
        "id": "popup_consent",
        "label": "Newsletter popup consent text",
        "default": "*By submitting this form, you agree to receive our emails."
      },
      {
        "type": "text",
        "id": "popup_decline_label",
        "label": "Newsletter popup decline text",
        "default": "No thanks!"
      },
      {
        "type": "checkbox",
        "id": "popup_show_image",
        "label": "Show newsletter popup image",
        "default": true
      },
      {
        "type": "image_picker",
        "id": "popup_image",
        "label": "Newsletter popup image"
      },
      {
        "type": "color",
        "id": "brand_gold_color",
        "label": "Brand gold highlight",
        "default": "#dbb66e"
      },
      {
        "type": "color",
        "id": "brand_header_color",
        "label": "Branded header background",
        "default": "#fffdf9"
      },
      {
        "type": "color",
        "id": "brand_footer_color",
        "label": "Branded footer background",
        "default": "#000000"
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart type",
        "default": "drawer",
        "options": [
          {
            "value": "drawer",
            "label": "Drawer"
          },
          {
            "value": "page",
            "label": "Page"
          }
        ]
      },
      {
        "type": "checkbox",
        "id": "show_vendor",
        "label": "Show product vendor",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "show_cart_note",
        "label": "Enable cart note",
        "default": false,
        "info": "Customers can add order instructions. Notes are saved with the Shopify cart and passed to checkout."
      },
      {
        "type": "header",
        "content": "Empty cart"
      },
      {
        "type": "text",
        "id": "cart_empty_heading",
        "label": "Heading",
        "default": "Your cart is empty"
      },
      {
        "type": "textarea",
        "id": "cart_empty_text",
        "label": "Text",
        "default": "Find a fragrance that feels like you."
      },
      {
        "type": "text",
        "id": "cart_empty_button",
        "label": "Button text",
        "default": "Explore perfumes"
      },
      {
        "type": "collection",
        "id": "cart_drawer_collection",
        "label": "Collection",
        "info": "Shown in the empty cart drawer. The continue-shopping button also links to this collection."
      },
      {
        "type": "header",
        "content": "Drawer colors"
      },
      {
        "type": "color",
        "id": "cart_background",
        "label": "Background",
        "default": "#ffffff"
      },
      {
        "type": "color",
        "id": "cart_text",
        "label": "Text",
        "default": "#181818"
      }
    ]
  }
]
