    {% when 'pinterest' %}<path d="m8 22 3-13m-1 7c2 3 7 2 9-2 3-7-2-12-7-12S3 5 3 10c0 3 1 4 3 5m6-9c-4 0-5 7-1 8 4 1 5-5 3-7-1-1-2-1-2-1Z"/>
    {% when 'heart' %}<path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z"/>
    {% when 'user' %}<circle cx="12" cy="7" r="4"/><path d="M3 22v-2a9 9 0 0 1 18 0v2"/>
    {% when 'bag' %}<path d="M4 7h16l-2 14H6L4 7Z"/><path d="M8 9V6a4 4 0 0 1 8 0v3M9 12v5m6-5v5"/>
    {% when 'menu' %}<path d="M3 6h18M3 12h18M3 18h18"/>
    {% when 'close' %}<path d="m5 5 14 14M19 5 5 19"/>
    {% when 'arrow' %}<path d="M4 12h16m-6-6 6 6-6 6"/>
    {% when 'chevron' %}<path d="m6 9 6 6 6-6"/>
    {% when 'pin' %}<path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>
    {% when 'mail' %}<rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 5 10 8L22 5"/>
    {% when 'play' %}<path d="m8 5 11 7-11 7V5Z"/>
    {% when 'check' %}<path d="m4 12 5 5L20 6"/>
    {% when 'filter' %}<path d="M4 5h16M7 12h10m-7 7h4"/>
    {% when 'bottle' %}<path d="M9 2h6v4H9zM8 6h8v4H8zM6 10h12v12H6z"/><path d="M9 14h6v4H9z"/>
  {% endcase %}
