{% if menu != blank %}
{% for link in menu.links %}{% if link.links != blank %}<details class="nav-dropdown"><summary>{{ link.title | escape }} {% render 'ts-icon', name: 'chevron' %}</summary><div class="nav-dropdown__panel">{% for child in link.links %}<div><a href="{{ child.url }}">{{ child.title | escape }}</a>{% for sub in child.links %}<a class="sub-link" href="{{ sub.url }}">{{ sub.title | escape }}</a>{% endfor %}</div>{% endfor %}</div></details>{% else %}<a href="{{ link.url }}">{{ link.title | escape }}</a>{% endif %}{% endfor %}
{% else %}
<a href="{{ routes.root_url }}">Home</a>
<details class="nav-dropdown">
  <summary>Shop {% render 'ts-icon', name: 'chevron' %}</summary>
  <div class="nav-dropdown__panel mega-menu">
    <div>
      <strong>The collection</strong>
      <a href="{{ routes.all_products_collection_url }}">All Perfumes</a>
    </div>
    <div>
      <strong>Shop by collection</strong>
      <a href="{{ routes.root_url }}collections/women-perfumes">Women's Fragrances</a>
      <a href="{{ routes.root_url }}collections/men-colognes">Men's Fragrances</a>
    </div>
    <div>
      <strong>Here to help</strong>
      <a href="{{ routes.root_url }}pages/contact-us">Contact Us</a>
      <a href="{{ routes.root_url }}pages/shipping-returns">Shipping & Returns</a>
      <a href="{{ routes.root_url }}pages/faq">FAQ</a>
      <a href="{{ routes.account_url }}">Track Your Order</a>
    </div>
  </div>
</details>
<details class="nav-dropdown"><summary>Pages {% render 'ts-icon', name: 'chevron' %}</summary><div class="nav-dropdown__panel"><div><a href="{{ routes.root_url }}pages/about-us">About Us</a><a href="{{ routes.root_url }}pages/faq">FAQ</a><a href="{{ routes.root_url }}pages/wishlist">Wishlist</a><a href="{{ routes.root_url }}pages/terms-conditions">Terms & Conditions</a></div></div></details><a href="{{ routes.root_url }}pages/contact-us">Contact</a>
{% endif %}
