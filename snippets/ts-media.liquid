{% liquid
  assign media_alt = alt | default: image.alt | default: ''
  assign media_loading = loading | default: 'lazy'
  assign media_width = width | default: 1600
  assign media_height = height | default: 1000
%}
{% if image != blank %}
  {{ image | image_url: width: media_width | image_tag: widths: '320, 480, 640, 960, 1200, 1600, 2000', sizes: sizes, loading: media_loading, alt: media_alt, class: class }}
{% elsif fallback != blank %}
  <img src="{{ fallback | asset_url }}" alt="{{ media_alt | escape }}" width="{{ media_width }}" height="{{ media_height }}" loading="{{ media_loading }}" class="{{ class }}">
{% endif %}
