{% if product != blank %}
  <article class="product-card" data-product-handle="{{ product.handle }}">
    <div class="product-card__media">
      <a href="{{ product.url }}" aria-label="{{ product.title | escape }}">
        {% render 'ts-media', image: product.featured_image, alt: product.title, width: 800, height: 1000, sizes: '(min-width: 990px) 25vw, 50vw' %}
        {% if product.images[1] != blank %}{% render 'ts-media', image: product.images[1], alt: product.title, width: 800, height: 1000, class: 'product-card__alternate', sizes: '(min-width: 990px) 25vw, 50vw' %}{% endif %}
      </a>
      {% if product.available == false %}<span class="badge badge--sold-out">Sold out</span>{% elsif product.compare_at_price > product.price %}
        {% assign saving = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round %}
        <span class="badge">Save {{ saving }}%</span>
      {% endif %}
      <div class="product-card__actions">
        {% if product.available %}{% if product.has_only_default_variant %}<form method="post" action="{{ routes.cart_add_url }}" data-cart-form><input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}"><button class="icon-button" type="submit" aria-label="Add {{ product.title | escape }} to cart" data-tooltip="Add to cart">{% render 'ts-icon', name: 'bag' %}</button><p class="form-error" role="alert"></p></form>{% else %}<button class="icon-button" data-quick-view="{{ product.url }}" aria-label="Select options for {{ product.title | escape }}" aria-haspopup="dialog" data-tooltip="Select options">{% render 'ts-icon', name: 'bag' %}</button>{% endif %}{% endif %}
        <button class="icon-button" data-quick-view="{{ product.url }}" aria-label="Quick view {{ product.title | escape }}" aria-haspopup="dialog" data-tooltip="Quick view">{% render 'ts-icon', name: 'eye' %}</button>
        <button class="icon-button" data-wishlist-toggle="{{ product.handle }}" aria-label="Save {{ product.title | escape }}" aria-pressed="false" data-tooltip="Add to wishlist">{% render 'ts-icon', name: 'heart' %}</button>
      </div>
    </div>
    <div class="product-card__info">
      {% assign rating = product.metafields.custom.demo_rating.value %}
      {% if rating != blank %}<div class="rating" aria-label="Demo rating: {{ rating }} out of 5"><span class="rating-stars" style="--rating:{{ rating | times: 20 }}%" aria-hidden="true">★★★★★</span></div>{% endif %}
      <h3><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>
      {% render 'ts-price', product: product %}
    </div>
  </article>
{% endif %}
