<dialog class="newsletter-popup dialog" id="NewsletterPopup" aria-labelledby="NewsletterHeading"><button class="dialog-close icon-button" data-dialog-close aria-label="Close newsletter">{% render 'ts-icon', name: 'close' %}</button><div class="newsletter-popup__image">{% render 'ts-media', fallback: 'ref-newsletter.jpg', alt: 'A woman discovering her signature fragrance', width: 750, height: 1023 %}</div><div class="newsletter-popup__content"><h2 id="NewsletterHeading">{{ settings.popup_heading | escape }}</h2><p>Sign up for our newsletter to be the first to learn about new arrivals, special promotions, and online exclusives.</p>{% form 'customer', id: 'PopupNewsletter', class: 'newsletter-form' %}<input type="hidden" name="contact[tags]" value="newsletter"><div class="newsletter-popup__form"><label class="visually-hidden" for="PopupEmail">Email address</label><input id="PopupEmail" type="email" name="contact[email]" placeholder="Enter your email" autocomplete="email" required><button class="button" type="submit">Subscribe</button></div>{% if form.posted_successfully? %}<p role="status">You're on the list. Thank you!</p>{% endif %}{{ form.errors | default_errors }}{% endform %}<small>*By submitting this form, you agree to receive our emails.</small><button class="newsletter-popup__decline" type="button" data-dialog-close>No thanks!</button></div></dialog>
