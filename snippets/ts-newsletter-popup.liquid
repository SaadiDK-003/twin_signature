<dialog class="newsletter-popup dialog" id="NewsletterPopup" aria-label="Newsletter"{% if settings.popup_heading != blank %} aria-labelledby="NewsletterHeading"{% endif %}><button class="dialog-close icon-button" data-dialog-close aria-label="Close newsletter">{% render 'ts-icon', name: 'close' %}</button>{% if settings.popup_show_image %}<div class="newsletter-popup__image">{% render 'ts-media', image: settings.popup_image, fallback: 'ref-newsletter.jpg', alt: 'A woman discovering her signature fragrance', width: 750, height: 1023 %}</div>{% endif %}<div class="newsletter-popup__content">{% if settings.popup_heading != blank %}<h2 id="NewsletterHeading">{{ settings.popup_heading | escape }}</h2>{% endif %}{% if settings.popup_text != blank %}<p>{{ settings.popup_text | escape }}</p>{% endif %}{% if settings.popup_button_label != blank %}{% form 'customer', id: 'PopupNewsletter', class: 'newsletter-form' %}<input type="hidden" name="contact[tags]" value="newsletter"><div class="newsletter-popup__form"><label class="visually-hidden" for="PopupEmail">Email address</label><input id="PopupEmail" type="email" name="contact[email]" placeholder="Enter your email" autocomplete="email" required><button class="button" type="submit">{{ settings.popup_button_label | escape }}</button></div>{% if form.posted_successfully? %}<p role="status">You're on the list. Thank you!</p>{% endif %}{{ form.errors | default_errors }}{% endform %}{% endif %}{% if settings.popup_consent != blank %}<small>{{ settings.popup_consent | escape }}</small>{% endif %}{% if settings.popup_decline_label != blank %}<button class="newsletter-popup__decline" type="button" data-dialog-close>{{ settings.popup_decline_label | escape }}</button>{% endif %}</div></dialog>
